#!raku

use Test;
use Terminal::UI::Pane;
use Terminal::ANSI;

my $p = Terminal::UI::Pane.new: :top<5>, :height<10>;
is $p.bottom, 15, 'bottom';
my $q = Terminal::UI::Pane.new: :width<5>, :left<3>;
is $q.right, 8, 'right';

my $r = Terminal::UI::Pane.new: :width<5>, :left<3>, :top<2>, :height<11>;

sub screen {
  virtual-screen.render(h => 5, w => 10).trans(' ' => '.')
}

disable-output;
$r.put('one');
$r.put('two');
is $r.lines.map(*.trim), <one two>, 'lines';

is screen, q:to/S/, 'two lines';
  ..........
  ..one.....
  ..two.....
  ..........
  ..........
  S

$r.scroll-up(:!limit);

is screen, q:to/S/, 'scroll up';
  ..........
  ..two.....
  ..........
  ..........
  ..........
  S

my $w = Terminal::UI::Pane.new: :width<10>, :left<0>, :top<0>, :height<11>;
$w.put: [ "" => "the quick brown fox jumps" ], :wrap<word>, :indent(2);
is $w.lines, (
  "  the     ",
  "  quick   ",
  "  brown   ",
  "  fox     ",
  "  jumps   ",
), 'word wrap with indent';

my $hw = Terminal::UI::Pane.new: :width<10>, :left<0>, :top<0>, :height<11>;
$hw.put: [ "" => "abcdefghij klmno" ], :wrap<hard>, :indent(3);
is $hw.lines, (
  "   abcdefg",
  "   hij klm",
  "   no     ",
), 'hard wrap with indent';

my $hg = Terminal::UI::Pane.new: :width<10>, :left<0>, :top<0>, :height<11>;
$hg.put: [ "" => "* the quick brown fox" ], :wrap<word>, :hang(2);
is $hg.lines, (
  "* the     ",
  "  quick   ",
  "  brown   ",
  "  fox     ",
), 'word wrap with hang';

done-testing;
