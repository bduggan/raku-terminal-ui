#!raku

use Test;
use Terminal::UI::Pane;
use Terminal::ANSI;

plan 21;

disable-output;

my $p = Terminal::UI::Pane.new: :width<20>, :left<1>, :top<1>, :height<5>;

# Test basic character printing
$p.print('h');
$p.print('e');
$p.print('l');
$p.print('l');
$p.print('o');
is $p.lines[0], 'hello', 'prints characters to line';

# Test newline increments line
$p.print("\n");
$p.print('w');
$p.print('o');
$p.print('r');
$p.print('l');
$p.print('d');
is $p.lines[1], 'world', 'newline moves to next line';

# Test carriage return resets column
$p.print("\r");
$p.print('X');
is $p.lines[1].trim, 'Xorld', 'carriage return resets to start of line';

# Test lines are stored for history
$p.print("\n");
$p.print('line3');
$p.print("\n");
$p.print('line4');
$p.print("\n");
$p.print('line5');
$p.print("\n");
$p.print('line6');
is $p.lines.elems, 6, 'lines accumulate for scrollback';
is $p.lines[5], 'line6', 'can access historical lines';

# Test escape sequences don't add to content
$p.print("\n");
$p.print("\e[31m");
$p.print('red');
is $p.lines[6], 'red', 'escape sequences not stored in content';

# Test that print wrote to the last line
is $p.lines.elems, 7, 'print writes to last line';

# Test first-visible updates when scrolling past height
is $p.first-visible, 2, 'first-visible updates when content exceeds height';

# Test batched strings with newlines
my $q = Terminal::UI::Pane.new: :width<20>, :left<1>, :top<1>, :height<5>;
$q.print("line1\nline2\nline3");
is $q.lines.elems, 3, 'string with newlines splits correctly';
is $q.lines[0], 'line1', 'first line from batched string';
is $q.lines[2], 'line3', 'third line from batched string';

# Test mixed content in one string
my $r = Terminal::UI::Pane.new: :width<20>, :left<1>, :top<1>, :height<5>;
$r.print("hello world\rXYZ");
is $r.lines[0].trim, 'XYZlo world', 'mixed string with carriage return';

# Test stream method with basic text
my $s = Terminal::UI::Pane.new: :width<20>, :left<1>, :top<1>, :height<5>;
my $supplier = Supplier.new;
$s.stream($supplier.Supply);
$supplier.emit("hello".encode);
sleep 0.1;
is $s.lines[0], 'hello', 'stream handles basic text';

# Test stream with newlines
my $t = Terminal::UI::Pane.new: :width<20>, :left<1>, :top<1>, :height<5>;
my $supplier2 = Supplier.new;
$t.stream($supplier2.Supply);
$supplier2.emit("line1\nline2".encode);
sleep 0.1;
is $t.lines.elems, 2, 'stream handles newlines';
is $t.lines[0], 'line1', 'stream first line correct';

# Test stream with ANSI escape sequences
my $u = Terminal::UI::Pane.new: :width<20>, :left<1>, :top<1>, :height<5>;
my $supplier3 = Supplier.new;
$u.stream($supplier3.Supply);
$supplier3.emit("\e[32mgreen\e[0m".encode);
sleep 0.1;
is $u.lines[0], 'green', 'stream filters ANSI sequences';

# Test combining put and print
my $v = Terminal::UI::Pane.new: :width<20>, :left<1>, :top<1>, :height<5>;
$v.put('first');
$v.print('second');
is $v.lines.elems, 2, 'put then print creates two lines';
is $v.lines[0], 'first', 'put creates first line';
is $v.lines[1], 'second', 'print goes to second line after put';

# Test print then put
my $w = Terminal::UI::Pane.new: :width<20>, :left<1>, :top<1>, :height<5>;
$w.print('hello ');
$w.print('world');
$w.put('!');
is $w.lines.elems, 2, 'two prints then put creates two lines';
is $w.lines[0], 'hello world', 'prints combine on same line, put adds new line';

done-testing;
